<Window x:Class="CCcut.TaskManagerWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CCcut"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="拆分队列">

    <Window.Resources>
        <!-- 声明转换器资源 -->
        <local:StatusToBoolConverter x:Key="StatusToBoolConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 批量操作 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="取消全部" Click="CancelAll_Click"
                    Style="{StaticResource ButtonDefault}"/>
            <Button Content="一键清空" Click="ClearAll_Click" Margin="10,0,0,0"
                    Style="{StaticResource ButtonDanger}"/>
            <Button Content="打开输出目录" Click="OpenOutputFolder_Click" Margin="10,0,0,0"
                    Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding TaskQueue}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.Header>
                        <CheckBox Click="SelectAll_Click" ToolTip="全选 / 取消全选"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/>
                <DataGridTemplateColumn Header="进度" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="15"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="日志提示" Binding="{Binding LogMessage}" Width="1.5*"/>
                <DataGridTemplateColumn Header="操作" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="取消" 
                                        Click="Button_Click"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource ButtonDefault.Small}"
                                        IsEnabled="{Binding Status, Converter={StaticResource StatusToBoolConverter}, ConverterParameter=cancel}"/>

                                <Button Content="播放" 
                                        Click="Button_Click_1"
                                        Tag="{Binding Id}"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource ButtonPrimary.Small}"
                                        IsEnabled="{Binding Status, Converter={StaticResource StatusToBoolConverter}, ConverterParameter=open}"/>

                                <Button Content="目录" 
                                        Click="Button_Click_3"
                                        Tag="{Binding Id}"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource ButtonDefault.Small}"
                                        IsEnabled="{Binding Status, Converter={StaticResource StatusToBoolConverter}, ConverterParameter=open}"/>

                                <Button Content="删除" 
                                        Click="Button_Click_2"
                                        Tag="{Binding Id}"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource ButtonDanger.Small}"
                                        IsEnabled="{Binding Status, Converter={StaticResource StatusToBoolConverter}, ConverterParameter=delete}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
