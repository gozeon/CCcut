<Window x:Class="CCcut.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CCcut"
        mc:Ignorable="d"
        Title="快捷键说明" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ShortcutGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,12,0,4"/>

                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#EEF2F7" CornerRadius="4"
                                                    Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Key}"
                                                           FontFamily="Consolas, Microsoft YaHei UI"
                                                           FontWeight="Bold" Foreground="#1E293B"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" Foreground="#334155"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="1" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource ButtonPrimary}" Click="Close_Click"/>
    </Grid>
</Window>
