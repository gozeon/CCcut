<Window x:Class="CCcut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CCcut"
        mc:Ignorable="d"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Icon="icon.ico"
        Title="CCcut" Height="600" Width="900">

    <Window.Resources>
        <!-- 声明转换器资源 -->
        <local:TicksToTimeStrConverter x:Key="TicksConverter"/>
        <local:TicksToPixelConverter x:Key="TicksToPixel"/>
        <local:TicksToWidthConverter x:Key="TicksToWidth"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="打开视频" Command="{Binding OpenVideoCommand}" />
            <TextBlock Text="{Binding VideoPath}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"  TextTrimming="CharacterEllipsis"  Foreground="Gray"/>
        </StackPanel>

        <!-- 播放器 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="240"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- Flyleaf 视频播放器渲染控件 -->
                <fl:FlyleafHost Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"  Player="{Binding VideoPlayer}">
                </fl:FlyleafHost>

                <ListBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding Paragraphs}" SelectedItem="{Binding ActiveParagraph, Mode=TwoWay}" HorizontalContentAlignment ="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                             
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10"></RowDefinition>
                                    <RowDefinition Height="auto"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="10"></RowDefinition>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Column="0" Grid.Row="1" Margin="0,0,10,0" IsChecked="{Binding IsSelect, Mode=TwoWay}"></CheckBox>
                                <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Center">
                                    <Run Text="{Binding StartTicks, Converter={StaticResource TicksConverter}}"></Run>
                                    <Run>-</Run>
                                    <Run Text="{Binding EndTicks , Converter={StaticResource TicksConverter}}"></Run>
                                </TextBlock>

                                <TextBox Grid.Column="1" Grid.Row="2" Margin="0,10,0,0" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                                     
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,0" Orientation="Horizontal">
                    <Button Content="添加段落" Command="{Binding AddParagraphCommand}"></Button>
                    <Button Style="{StaticResource ButtonDanger}" Margin="10,0,0,0" Content="删除段落" Command="{Binding RemoveParagraphCommand}"></Button>
                    <Button Style="{StaticResource ButtonInfo}" Margin="10,0,0,0" Content="拆分段落" Command="{Binding SplitParagraphCommand}"></Button>
                </StackPanel>
            </Grid>

            <Canvas Grid.Row="1" Margin="0,0,0,10" Height="60" Background="Transparent" x:Name="ProgressBarCanvas"
                    MouseLeftButtonUp="ProgressBarCanvas_MouseLeftButtonUp"
                    MouseLeftButtonDown="ProgressBarCanvas_MouseLeftButtonDown"
                    MouseMove="ProgressBarCanvas_MouseMove"
                    MouseLeave="ProgressBarCanvas_MouseLeave">

                <Rectangle Canvas.Top="15" Height="30"  Fill="#D7E2EE" RadiusX="3"  RadiusY="3" Width="{Binding ElementName=ProgressBarCanvas, Path=ActualWidth}" />

                <ItemsControl ItemsSource="{Binding Paragraphs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding ElementName=ProgressBarCanvas,Path=ActualWidth}"></Canvas>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top" Value="15"/>
                            <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}"/>
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource TicksToPixel}">
                                        <Binding Path="StartTicks" />
                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type Window}}" Path="DataContext.VideoPlayer.Duration" />
                                        <Binding ElementName="ProgressBarCanvas" Path="ActualWidth" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Width" >
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource TicksToWidth}">
                                        <Binding Path="DurationTicks" />
                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type Window}}" Path="DataContext.VideoPlayer.Duration" />
                                        <Binding ElementName="ProgressBarCanvas" Path="ActualWidth" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 选用 Border 容纳内部的三个交互手柄 -->
                            <Border Height="30" CornerRadius="3" Opacity="0.7" HorizontalAlignment="Stretch">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding ColorHex}"/>
                                </Border.Background>
                                <!-- Grid 内部横向切分为：[左边手柄(4px) | 中间拖拽区(自动) | 右边手柄(4px)] -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. 左边缘拉伸手柄 -->
                                    <Thumb Grid.Column="0"  Cursor="SizeWE" DragDelta="LeftThumb_DragDelta" PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <!-- 白色半透明竖条，视觉提示可以拉伸 -->
                                                            <Rectangle Fill="#FFFFFF" Opacity="0.4"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>

                                    <!-- 2. 中间整体拖拽区 -->
                                    <Thumb Grid.Column="1" Cursor="Hand" DragDelta="BodyThumb_DragDelta" PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <!-- 透明背景，保证中间能隐约看到文字或高亮色，且能捕捉鼠标操作 -->
                                                            <Grid Background="Transparent">
                                                                <!-- 你甚至可以在这里放个 TextBlock 显示 Title -->
                                                                <TextBlock Text="{Binding Title}" Foreground="#1E293B" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           FontSize="11" FontWeight="Bold"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>

                                    <!-- 3. 右边缘拉伸手柄 -->
                                    <Thumb Grid.Column="2" Cursor="SizeWE" DragDelta="RightThumb_DragDelta" PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Rectangle Fill="#FFFFFF" Opacity="0.4"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Line x:Name="HoverLine" Stroke="#FFA2A2" StrokeThickness="1" X1="0" Y1="0" X2="0" Y2="60" IsHitTestVisible="False">
                    <Line.RenderTransform>
                        <TranslateTransform X="{Binding HoverX}" />
                    </Line.RenderTransform>
                    <Line.Style>
                        <Style TargetType="Line">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <!-- 只要鼠标划入进度条，立刻显示虚影 -->
                                <DataTrigger Binding="{Binding ElementName=ProgressBarCanvas, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Line.Style>
                </Line>

                <Line Stroke="#FB2C36" StrokeThickness="1" X1="0" Y1="0" X2="0" Y2="60" IsHitTestVisible="False">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="LineTransform">
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource TicksToPixel}">
                                    <Binding Path="CurTime" />
                                    <Binding Path="VideoPlayer.Duration" />
                                    <Binding ElementName="ProgressBarCanvas" Path="ActualWidth" />
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Line.RenderTransform>
                </Line>

            </Canvas>



            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="开始对齐游标" Command="{Binding ExecuteAlignToCursorCommand}" CommandParameter="{x:Static local:AlignDirection.Left}"></Button>
                <Button Content="结束对齐游标" Command="{Binding ExecuteAlignToCursorCommand}" CommandParameter="{x:Static local:AlignDirection.Right}"></Button>
                <TextBlock Text="   "></TextBlock>
                <Button Content="{Binding PlayButtonText}" Command="{Binding VideoPlayer.Commands.TogglePlayPause}" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                    <Run Text="{Binding CurTime, Converter={StaticResource TicksConverter}, Mode=OneWay}"></Run>
                    <Run Text="/"></Run>
                    <Run Text="{Binding VideoPlayer.Duration, Converter={StaticResource TicksConverter}, Mode=OneWay}"></Run>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 运行日志 -->
        <GroupBox Grid.Row="3" Header="运行日志" Padding="6" Height="120" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource GroupBoxTab}">
            <TextBox x:Name="LogTextBox" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
             TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
