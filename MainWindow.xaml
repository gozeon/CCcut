<Window x:Class="CCcut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CCcut"
        mc:Ignorable="d"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Icon="icon.ico"
        Title="CCcut" Height="600" Width="900">

    <Window.Resources>
        <!-- 声明转换器资源 -->
        <local:TicksToTimeStrConverter x:Key="TicksConverter"/>
        <local:TicksToPixelConverter x:Key="TicksToPixel"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="打开视频" Command="{Binding OpenVideoCommand}" />
            <TextBlock Text="{Binding VideoPath}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"  TextTrimming="CharacterEllipsis"  Foreground="Gray"/>
        </StackPanel>

        <!-- 播放器 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- Flyleaf 视频播放器渲染控件 -->
            <fl:FlyleafHost Grid.Row="0" Margin="0,0,0,10" Player="{Binding VideoPlayer}">
            </fl:FlyleafHost>

            <Canvas Grid.Row="1" Margin="0,0,0,10" Height="40" Background="Transparent" x:Name="ProgressBarCanvas">

                <Rectangle Canvas.Top="4" Height="30"  Fill="#F8FAFC" RadiusX="3"  RadiusY="3" Width="{Binding ElementName=ProgressBarCanvas, Path=ActualWidth}" />

                <Line Stroke="#FF0000" StrokeThickness="1" X1="0" Y1="0" X2="0" Y2="40">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="LineTransform">
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource TicksToPixel}">
                                    <Binding Path="CurTime" />
                                    <Binding Path="VideoPlayer.Duration" />
                                    <Binding ElementName="ProgressBarCanvas" Path="ActualWidth" />
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Line.RenderTransform>
                </Line>

            </Canvas>

            <Grid  Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding PlayButtonText}" Command="{Binding VideoPlayer.Commands.TogglePlayPause}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="{Binding CurTime, Converter={StaticResource TicksConverter}, Mode=OneWay}"></Run>
                        <Run Text="/"></Run>
                        <Run Text="{Binding VideoPlayer.Duration, Converter={StaticResource TicksConverter}, Mode=OneWay}"></Run>
                    </TextBlock>
                </StackPanel>

                <Slider Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Maximum="{Binding VideoPlayer.Duration}" Value="{Binding VideoPlayer.CurTime}" IsMoveToPointEnabled="True" SmallChange="{Binding VideoPlayer.Config.Player.SeekOffset}"/>

            </Grid>
        </Grid>

        <!-- 运行日志 -->
        <GroupBox Grid.Row="3" Header="运行日志" Padding="6" Height="120" hc:TitleElement.TitlePlacement="Left" Style="{StaticResource GroupBoxTab}">
            <TextBox x:Name="LogTextBox" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
             TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
